{
    "name": "agent-sessions-elgato",
    "private": true,
    "scripts": {
        "build": "rollup -c && python3 -I scripts/profile.py && npm run native",
        "native": "clang -O2 -Wall -o com.rucker.agent-sessions.sdPlugin/bin/reenumerate native/reenumerate.c -framework IOKit -framework CoreFoundation",
        "check": "tsc --noEmit",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.rucker.agent-sessions\""
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "1.10.2",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "3.0.2",
        "@elgato/utils": "0.6.1"
    }
}
